# Copy to deploy/aws/.env on your EC2 instance (never commit real secrets).
# cp deploy/aws/.env.example deploy/aws/.env

# ── Public URLs (used for CORS + OAuth redirects) ─────────────────────────────
# Same-origin if frontend is served by nginx on this EC2 (recommended):
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com,http://YOUR_EC2_PUBLIC_IP
PUBLIC_API_URL=https://your-domain.com
PUBLIC_FRONTEND_URL=https://your-domain.com

# Frontend build: leave empty for same-origin (/api via nginx)
VITE_API_BASE_URL=

# ── JWT (required — generate with: openssl rand -base64 32) ───────────────────
JWT_ISSUER=devconnect
JWT_ACCESS_TOKEN_SECRET=REPLACE-WITH-32-PLUS-CHAR-SECRET
JWT_REFRESH_TOKEN_SECRET=REPLACE-WITH-32-PLUS-CHAR-SECRET

# ── Database ──────────────────────────────────────────────────────────────────
# Option A: PostgreSQL container on EC2 (default in docker-compose.aws.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE-STRONG-DB-PASSWORD

# Option B: Amazon RDS — set RDS_HOST and use docker-compose.aws-rds.yml overlay
# RDS_HOST=devconnect.xxxxx.eu-north-1.rds.amazonaws.com
# RDS_PORT=5432
# RDS_SSL_MODE=require

# JDBC URLs (Option A — postgres service name "postgres")
AUTH_DB_URL=jdbc:postgresql://postgres:5432/devconnect_auth
USER_DB_URL=jdbc:postgresql://postgres:5432/devconnect_user
CHAT_DB_URL=jdbc:postgresql://postgres:5432/devconnect_chat
NOTIFICATION_DB_URL=jdbc:postgresql://postgres:5432/devconnect_notification
PAYMENT_DB_URL=jdbc:postgresql://postgres:5432/devconnect_payment
MATCHING_DB_URL=jdbc:postgresql://postgres:5432/devconnect_matching
MENTOR_DB_URL=jdbc:postgresql://postgres:5432/devconnect_mentor

AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=REPLACE-STRONG-DB-PASSWORD
USER_DB_USERNAME=postgres
USER_DB_PASSWORD=REPLACE-STRONG-DB-PASSWORD
CHAT_DB_USERNAME=postgres
CHAT_DB_PASSWORD=REPLACE-STRONG-DB-PASSWORD
NOTIFICATION_DB_USERNAME=postgres
NOTIFICATION_DB_PASSWORD=REPLACE-STRONG-DB-PASSWORD
PAYMENT_DB_USERNAME=postgres
PAYMENT_DB_PASSWORD=REPLACE-STRONG-DB-PASSWORD
MATCHING_DB_USERNAME=postgres
MATCHING_DB_PASSWORD=REPLACE-STRONG-DB-PASSWORD
MENTOR_DB_USERNAME=postgres
MENTOR_DB_PASSWORD=REPLACE-STRONG-DB-PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Kafka (disable on small instances — saves ~512MB RAM) ─────────────────────
KAFKA_ENABLED=false

# ── Payments ──────────────────────────────────────────────────────────────────
PAYMENT_GATEWAY_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── AI / Ollama (optional — run: bash deploy/aws/deploy.sh with ai profile) ───
# Uncomment to enable AI mock interview (pull model after deploy):
# OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1
# Optional AI profile (uncomment OLLAMA_BASE_URL above, then set):
# COMPOSE_PROFILES=local-db,ai
GEMINI_API_KEY=

# ── OAuth (update redirect URIs to your public domain) ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.com/api/recruiter/integrations/oauth/google/callback
GOOGLE_OAUTH_FRONTEND_REDIRECT=https://your-domain.com/recruiter/oauth/callback

ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_OAUTH_REDIRECT_URI=https://your-domain.com/api/recruiter/integrations/oauth/zoom/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_OAUTH_REDIRECT_URI=https://your-domain.com/api/recruiter/integrations/oauth/teams/callback

# ── JVM tuning (8GB EC2 — leave defaults unless OOM) ─────────────────────────
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=70.0 -Xms128m
