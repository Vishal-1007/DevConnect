# Leave empty in dev to use Vite proxy (vite.config.ts → gateway :8080)
# Set for production builds, e.g. https://api.devconnect.example
VITE_API_BASE_URL=

# Google OAuth (client-side validation before connect)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/recruiter/oauth/callback
