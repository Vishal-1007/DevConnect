# Copy to .env and set strong secrets before any shared/staging/prod deploy.

# API entry point (gateway-service, port 8080)
GATEWAY_PORT=8080

# Downstream URIs (local dev defaults; Docker Compose overrides these)
AUTH_SERVICE_URI=http://localhost:8081
USER_SERVICE_URI=http://localhost:8082
CHAT_SERVICE_URI=http://localhost:8083
CHAT_SERVICE_WS_URI=ws://localhost:8083
NOTIFICATION_SERVICE_URI=http://localhost:8084
MATCHING_SERVICE_URI=http://localhost:8085
MENTOR_SERVICE_URI=http://localhost:8086
ANALYTICS_SERVICE_URI=http://localhost:8087
ADMIN_SERVICE_URI=http://localhost:8088

JWT_ISSUER=devconnect
JWT_ACCESS_TOKEN_SECRET=replace-with-32-plus-char-secret
JWT_REFRESH_TOKEN_SECRET=replace-with-32-plus-char-secret

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

AUTH_DB_URL=jdbc:postgresql://localhost:5432/devconnect_auth
USER_DB_URL=jdbc:postgresql://localhost:5432/devconnect_user
CHAT_DB_URL=jdbc:postgresql://localhost:5432/devconnect_chat
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/devconnect_notification
MATCHING_DB_URL=jdbc:postgresql://localhost:5432/devconnect_matching
MENTOR_DB_URL=jdbc:postgresql://localhost:5432/devconnect_mentor

AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=postgres
USER_DB_USERNAME=postgres
USER_DB_PASSWORD=postgres
CHAT_DB_USERNAME=postgres
CHAT_DB_PASSWORD=postgres
NOTIFICATION_DB_USERNAME=postgres
NOTIFICATION_DB_PASSWORD=postgres
MATCHING_DB_USERNAME=postgres
MATCHING_DB_PASSWORD=postgres
MENTOR_DB_USERNAME=postgres
MENTOR_DB_PASSWORD=postgres

# Google Calendar OAuth (payment-service)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8089/api/recruiter/integrations/oauth/google/callback
GOOGLE_OAUTH_FRONTEND_REDIRECT=http://localhost:5173/recruiter/oauth/callback

ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_OAUTH_REDIRECT_URI=http://localhost:8089/api/recruiter/integrations/oauth/zoom/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8089/api/recruiter/integrations/oauth/teams/callback

REDIS_URL=redis://localhost:6379
